[Unit]
Description=L4Load HA director %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
RuntimeDirectory=l4load-ha-%i
ExecStartPre=/usr/sbin/keepalived -t -f /etc/l4load/ha-%i.conf
ExecStartPre=/usr/sbin/sysctl -qw net.ipv4.vs.expire_quiescent_template=1
ExecStartPre=/usr/bin/python3 /usr/local/libexec/l4load-ipvs-gate.py
ExecStart=/usr/sbin/keepalived -n -l -f /etc/l4load/ha-%i.conf -p /run/l4load-ha-%i/parent.pid -r /run/l4load-ha-%i/vrrp.pid -c /run/l4load-ha-%i/checkers.pid
ExecReload=/usr/sbin/keepalived -t -f /etc/l4load/ha-%i.conf
ExecReload=/usr/sbin/sysctl -qw net.ipv4.vs.expire_quiescent_template=1
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
KillMode=control-group

[Install]
WantedBy=multi-user.target
