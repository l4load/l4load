[Unit]
Description=L4Load IPVS director %i
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
RuntimeDirectory=l4load-ipvs-%i
ExecStartPre=/usr/sbin/keepalived -t -f /etc/l4load/ipvs-%i.conf
ExecStartPre=/usr/bin/python3 /usr/local/libexec/l4load-ipvs-gate.py
ExecStart=/usr/sbin/keepalived -n -l -C -I -f /etc/l4load/ipvs-%i.conf -p /run/l4load-ipvs-%i/parent.pid -c /run/l4load-ipvs-%i/checkers.pid
ExecReload=/usr/sbin/keepalived -t -f /etc/l4load/ipvs-%i.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
KillMode=control-group

[Install]
WantedBy=multi-user.target
