[Unit]
Description=L4Load IPVS director
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
RuntimeDirectory=l4load-ipvs
ExecStartPre=/usr/sbin/keepalived -t -f /etc/l4load/ipvs.conf
ExecStartPre=/usr/sbin/sysctl -qw net.ipv4.vs.expire_quiescent_template=1
ExecStartPre=/usr/bin/python3 /usr/local/libexec/l4load-ipvs-gate.py
ExecStart=/usr/sbin/keepalived -n -l -C -I -f /etc/l4load/ipvs.conf -p /run/l4load-ipvs/parent.pid -c /run/l4load-ipvs/checkers.pid
ExecReload=/usr/sbin/keepalived -t -f /etc/l4load/ipvs.conf
ExecReload=/usr/sbin/sysctl -qw net.ipv4.vs.expire_quiescent_template=1
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=1
KillMode=control-group

[Install]
WantedBy=multi-user.target
